# Native whitespace defaults; language formatters remain the formatting owners.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.{py,pyi,rs}]
indent_size = 4

[*.md]
# Two trailing spaces can be a deliberate Markdown line break.
trim_trailing_whitespace = false

[{Makefile,*.mk}]
indent_style = tab
