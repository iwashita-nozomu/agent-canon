# The public AgentCanon test image copies the source Git root, including tests,
# the typed test list, and the runner. Keep repository-local state out of the
# build context while retaining every tracked source surface needed by tests.
# Retain commit objects and refs needed for the standalone image's complete
# local history, while excluding host remotes, credentials, indexes, and logs.
.git/*
!.git/HEAD
!.git/objects/
!.git/objects/**
.git/objects/info/
.git/objects/info/**
!.git/refs/
.git/refs/*
!.git/refs/heads/
!.git/refs/heads/**
!.git/packed-refs
.git/config
.git/index
.git/logs/
.git/logs/**
.git/hooks/
.git/hooks/**
.git/worktrees/
.git/worktrees/**
.git/objects/info/alternates
.agent-canon
.state
vendor/agent-canon
.env
.env.*
**/*.pem
**/*.key
**/id_rsa
**/id_ed25519
**/credentials.json
**/secrets.json
**/__pycache__
**/.mypy_cache
**/.pytest_cache
**/.ruff_cache
**/.venv
**/target
experiments/*/result
experiments/*/result/**
