# The standalone image is built with the repository root as context:
#   docker build -f bootstrap/container/image/Dockerfile .
# Keep the context deny-by-default while explicitly exposing Dockerfile inputs.
# The disposable test image reuses one source snapshot for the live projection
# and native Lean proof suites; its test-only dependency manifest stays outside
# the shared tool-image dependency manifest.
