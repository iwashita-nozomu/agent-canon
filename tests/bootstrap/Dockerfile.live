# @dependency-start
# contract environment
# responsibility Defines the disposable test image for AgentCanon live and native
# proof checks.
# upstream implementation ./docker.sh selects and runs each test capability profile
# downstream design ./lean-proof-dependencies.toml pins the native Lean test toolchain
# downstream test ./test_live_projection_authority.py exercises the shared host Docker daemon
# downstream implementation ../../tools/analysis/proof/lean_proof_env.py owns native Lean behavior
# @dependency-end

FROM ubuntu:24.04@sha256:33ceb71981b602c1a7443a53469e4dba065f7503eab3078a2d7a57a2ab987517

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        curl \
        docker.io \
        git \
        python3-packaging \
        python3.12 \
        python3-pytest \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/agent-canon/source
COPY . /opt/agent-canon/source
