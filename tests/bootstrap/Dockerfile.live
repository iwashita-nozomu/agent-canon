# @dependency-start
# contract environment
# responsibility Defines AgentCanon's disposable live, proof, and full-check test image.
# upstream implementation ./docker.sh selects and runs each test capability profile
# upstream implementation ../../tools/analysis/dependencies/dependency_plan.py invokes the typed image installer
# upstream implementation ../../tools/runtime/container/devcontainer_dependencies.py installs the image dependency plan
# upstream implementation ../../tools/runtime/values.py refines decoded dependency records
# upstream implementation ../../tools/repository/workspace/parent_root_side_effects.py owns installer side-effect boundaries
# upstream implementation ../../tools/runtime/artifacts/runtime_artifacts.py owns external runtime boundaries
# upstream environment ../../bootstrap/container/image/dependencies.toml pins image providers
# upstream implementation ../../tools/runtime/dispatch/agent-canon/Cargo.toml defines the CLI crate
# upstream environment ../../tools/runtime/dispatch/agent-canon/Cargo.lock locks CLI build dependencies
# upstream implementation ../../tools/runtime/dispatch/agent-canon/src/main.rs is the compiled CLI entrypoint
# upstream implementation ../../tools/runtime/dispatch/agent-canon/src/graph.rs embeds shared runtime sources
# upstream implementation ../../tools/runtime/manifest/surface_manifest.py is embedded by the graph CLI
# upstream implementation ../../tools/agent/skills/skill_projection_registry.py is embedded by the graph CLI
# upstream implementation ../../documents/runtime/shared-runtime-surfaces.toml is embedded by the graph CLI
# downstream design ./lean-proof-dependencies.toml pins the native Lean test toolchain
# downstream implementation ./test_live_projection_authority.py exercises the shared host Docker daemon
# downstream implementation ../../tools/analysis/proof/lean_proof_env.py owns native Lean behavior
# @dependency-end

FROM ubuntu:24.04@sha256:33ceb71981b602c1a7443a53469e4dba065f7503eab3078a2d7a57a2ab987517

ARG TARGETARCH

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    CARGO_HOME=/usr/local/share/agent-canon/test-toolchains/cargo \
    RUSTUP_HOME=/usr/local/share/agent-canon/test-toolchains/rustup \
    PIPX_HOME=/usr/local/share/agent-canon/test-toolchains/pipx \
    PIPX_BIN_DIR=/usr/local/bin \
    PUPPETEER_CACHE_DIR=/usr/local/share/agent-canon/puppeteer \
    PUPPETEER_CHROME_SKIP_DOWNLOAD=true \
    PATH=/usr/local/share/agent-canon/test-toolchains/cargo/bin:/usr/local/bin:/usr/bin:/bin

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        curl \
        docker.io \
        git \
        python3-packaging \
        python3.12 \
        python3-pytest \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/agent-canon/source

# Keep the image installer cache key limited to its manifest and actual import
# closure; ordinary source revisions do not reinstall the full-check providers.
COPY tools/__init__.py /opt/agent-canon/source/tools/
COPY tools/analysis/__init__.py /opt/agent-canon/source/tools/analysis/
COPY tools/analysis/dependencies/__init__.py \
     tools/analysis/dependencies/dependency_plan.py \
     /opt/agent-canon/source/tools/analysis/dependencies/
COPY tools/runtime/__init__.py tools/runtime/values.py /opt/agent-canon/source/tools/runtime/
COPY tools/runtime/container/__init__.py \
     tools/runtime/container/devcontainer_dependencies.py \
     /opt/agent-canon/source/tools/runtime/container/
COPY tools/runtime/artifacts/__init__.py \
     tools/runtime/artifacts/runtime_artifacts.py \
     /opt/agent-canon/source/tools/runtime/artifacts/
COPY tools/repository/__init__.py /opt/agent-canon/source/tools/repository/
COPY tools/repository/workspace/parent_root_side_effects.py /opt/agent-canon/source/tools/repository/workspace/
COPY bootstrap/container/image/dependencies.toml /opt/agent-canon/source/bootstrap/container/image/

# The profile first affects the provider/build layers below, not common setup.
ARG TEST_PROFILE=live-projection
# The full-check profile uses the same typed providers as the shared image,
# but installs only the tools required by run_all_checks. Its package and
# toolchain layer depends on the installer inputs above, not the whole source.
# Full-check selects mmdc and its typed Puppeteer/browser runtime closure.
RUN if [ "${TEST_PROFILE}" = "full-checks" ]; then \
      apt-get update; \
      apt-get install --yes --no-install-recommends \
        build-essential cmake python3-yaml; \
      case "${TARGETARCH}" in \
        amd64) rustup_target=x86_64-unknown-linux-gnu; rustup_sha=20a06e644b0d9bd2fbdbfd52d42540bdde820ea7df86e92e533c073da0cdd43c ;; \
        arm64) rustup_target=aarch64-unknown-linux-gnu; rustup_sha=e3853c5a252fca15252d07cb23a1bdd9377a8c6f3efa01531109281ae47f841c ;; \
        *) echo "unsupported_target_arch=${TARGETARCH}" >&2; exit 2 ;; \
      esac; \
      install -d -m 0755 "${CARGO_HOME}" "${RUSTUP_HOME}" "${PIPX_HOME}"; \
      curl --fail --silent --show-error --location --proto '=https' --tlsv1.2 --output /usr/local/bin/rustup-init "https://static.rust-lang.org/rustup/archive/1.28.2/${rustup_target}/rustup-init"; \
      echo "${rustup_sha}  /usr/local/bin/rustup-init" | sha256sum --check --strict; \
      chmod 0555 /usr/local/bin/rustup-init; \
      rustup-init -y --no-modify-path --default-toolchain none; \
      install -d -m 0755 "${PUPPETEER_CACHE_DIR}"; \
      python3 -m tools.analysis.dependencies.dependency_plan image-install \
        --workspace /opt/agent-canon/source \
        --manifest /opt/agent-canon/source/bootstrap/container/image/dependencies.toml \
        --records ruff basedpyright check-jsonschema yamllint shellcheck actionlint zizmor rust-toolchain python3-pytest \
        markdownlint-cli2 node quarto lychee mermaid-cli \
        --format text; \
      rm -f /usr/local/bin/rustup-init; \
      rm -rf /tmp/* /var/lib/apt/lists/*; \
    fi

# Cargo's cache key follows only the crate, lockfile, and exact files read by
# compile-time include_bytes! expressions.
COPY tools/runtime/dispatch/agent-canon/Cargo.toml \
     tools/runtime/dispatch/agent-canon/Cargo.lock \
     /opt/agent-canon/source/tools/runtime/dispatch/agent-canon/
COPY tools/runtime/dispatch/agent-canon/src/ /opt/agent-canon/source/tools/runtime/dispatch/agent-canon/src/
COPY tools/runtime/manifest/surface_manifest.py /opt/agent-canon/source/tools/runtime/manifest/surface_manifest.py
COPY tools/agent/skills/skill_projection_registry.py \
     /opt/agent-canon/source/tools/agent/skills/skill_projection_registry.py
COPY documents/runtime/shared-runtime-surfaces.toml \
     /opt/agent-canon/source/documents/runtime/shared-runtime-surfaces.toml

RUN if [ "${TEST_PROFILE}" = "full-checks" ]; then \
      CARGO_TARGET_DIR=/tmp/agent-canon-test-cargo-target cargo build \
        --locked --release \
        --manifest-path /opt/agent-canon/source/tools/runtime/dispatch/agent-canon/Cargo.toml; \
      install -m 0555 /tmp/agent-canon-test-cargo-target/release/agent-canon /usr/local/bin/agent-canon; \
      rm -rf /tmp/agent-canon-test-cargo-target /tmp/*; \
    fi

COPY . /opt/agent-canon/source

# Docker consumes .dockerignore as context metadata instead of copying it.
# The task-owned context carries its exact committed bytes under tests/bootstrap.
RUN cp /opt/agent-canon/source/tests/bootstrap/.agent-canon-dockerignore-input \
      /opt/agent-canon/source/.dockerignore \
    && rm /opt/agent-canon/source/tests/bootstrap/.agent-canon-dockerignore-input

# Keep the revision build argument out of every cacheable install/compile RUN.
ARG SOURCE_REVISION=unknown
LABEL org.opencontainers.image.revision="${SOURCE_REVISION}" \
      io.agent-canon.test.profile="${TEST_PROFILE}"

# The source snapshot is created after the expensive dependency and CLI layers,
# so Git provenance changes do not invalidate either cached build step.
RUN if [ "${TEST_PROFILE}" = "full-checks" ]; then \
      git -C /opt/agent-canon/source init --quiet --initial-branch=main; \
      git -C /opt/agent-canon/source config user.name "AgentCanon test image"; \
      git -C /opt/agent-canon/source config user.email "agent-canon-test-image@example.invalid"; \
      git -C /opt/agent-canon/source add --all; \
      git -C /opt/agent-canon/source commit --quiet -m "AgentCanon source snapshot ${SOURCE_REVISION}"; \
      chmod -R a-w /opt/agent-canon/source; \
    fi
