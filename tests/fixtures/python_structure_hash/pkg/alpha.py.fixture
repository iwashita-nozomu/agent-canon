class _Config:
    pass


def _consume(config: _Config) -> _Config:
    return config


def _target(value):
    return value


def _inner(value):
    return value


def _owner(value):
    _target(value)
    _target(value + 1)
    return value


def _wrapper(value):
    return _inner(value)


