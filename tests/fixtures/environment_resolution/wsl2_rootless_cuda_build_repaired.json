{
  "schema": "agent-canon.environment-resolution.gpu-build-capability",
  "version": 2,
  "builder": {
    "platform": "wsl2-ubuntu-24.04",
    "builder_name": "rootless",
    "daemon_mode": "rootless",
    "builder_driver": "docker",
    "docker_version": "29.7.2",
    "buildx_version": "0.36.1",
    "buildkit_version": "0.32.2",
    "requested_devices": [
      "nvidia.com/gpu=all",
      "local.wsl/cuda-build=all"
    ],
    "cdi_devices": [
      "nvidia.com/gpu=all",
      "local.wsl/cuda-build=all"
    ]
  },
  "stages": {
    "device_entitlement": "supported",
    "cdi_inventory": "matched",
    "run_device_request": "accepted",
    "device_nodes": "present",
    "driver_loader": "complete",
    "cuda_driver_api": "ready",
    "cuda_compile_run": "passed",
    "runtime_cdi": "passed"
  },
  "evidence": {
    "device_entitlement": {
      "summary": "The build request limited entitlement to the NVIDIA and WSL CUDA build devices.",
      "probe_kind": "device_entitlement",
      "command": [
        "docker",
        "buildx",
        "build",
        "--allow",
        "device=nvidia.com/gpu=all",
        "--allow",
        "device=local.wsl/cuda-build=all"
      ],
      "exit_code": 0,
      "observations": [
        "two exact device entitlements accepted"
      ]
    },
    "cdi_inventory": {
      "summary": "The builder resolved both exact requested CDI devices.",
      "probe_kind": "cdi_inventory",
      "command": [
        "docker",
        "buildx",
        "inspect",
        "rootless",
        "--bootstrap"
      ],
      "exit_code": 0,
      "observations": [
        "nvidia.com/gpu=all",
        "local.wsl/cuda-build=all"
      ]
    },
    "run_device_request": {
      "summary": "BuildKit entered a step requesting the NVIDIA device and read-only WSL thunk addon.",
      "probe_kind": "run_device_request",
      "command": [
        "docker",
        "buildx",
        "build",
        "--allow",
        "device"
      ],
      "exit_code": 0,
      "observations": [
        "both RUN --device requests accepted"
      ]
    },
    "device_nodes": {
      "summary": "The repaired build step retained the WSL GPU transport device.",
      "probe_kind": "device_nodes",
      "command": [
        "test",
        "-c",
        "/dev/dxg"
      ],
      "exit_code": 0,
      "observations": [
        "/dev/dxg"
      ]
    },
    "driver_loader": {
      "summary": "The read-only WSL addon supplied the thunk and complete loader surface.",
      "probe_kind": "driver_loader",
      "command": [
        "test",
        "-e",
        "/usr/lib/wsl/lib/libcuda.so.1"
      ],
      "exit_code": 0,
      "observations": [
        "libcuda.so.1 158304 bytes WSL thunk",
        "libcuda.so.1.1 29169208 bytes driver body"
      ]
    },
    "cuda_driver_api": {
      "summary": "The CUDA count probe initialized the driver and read both devices.",
      "probe_kind": "cuda_driver_api",
      "command": [
        "/tmp/cuda-driver-api-probe"
      ],
      "exit_code": 0,
      "observations": [
        "cuInit status=0",
        "cuDeviceGetCount status=0 count=2",
        "RTX 2080 capability=7.5"
      ]
    },
    "cuda_compile_run": {
      "summary": "The parent-owned CUDA/Kokkos build and GPU-profile C++ tests completed.",
      "probe_kind": "cuda_compile_run",
      "command": [
        "cmake",
        "--build",
        "build",
        "--target",
        "gpu-profile-tests"
      ],
      "exit_code": 0,
      "observations": [
        "Kokkos_ARCH_TURING75=ON",
        "IMAGE_KOKKOS_CUDA_PROVIDER=present",
        "GPU-profile C++ unit tests 3/3 passed"
      ]
    },
    "runtime_cdi": {
      "summary": "The rebuilt parent image resolved and executed the CUDA runtime route.",
      "probe_kind": "runtime_cdi",
      "command": [
        "docker",
        "run",
        "--rm",
        "--device",
        "nvidia.com/gpu=all",
        "<parent-image>",
        "nvidia-smi",
        "-L"
      ],
      "exit_code": 0,
      "observations": [
        "BACKEND_COMPUTE_ENVIRONMENT=cuda",
        "compute_environment: cuda"
      ]
    }
  }
}
