{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "cppBuildDirectory",
      "type": "promptString",
      "description": "CMake build directory containing compile_commands.json",
      "default": "build/cpp/dev"
    }
  ],
  "tasks": [
    {
      "label": "AgentCanon: Docs Check",
      "type": "shell",
      "command": "\"${workspaceFolder}/tools/bin/agent-canon\" docs check",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "AgentCanon: Convention Check",
      "type": "shell",
      "command": "python3 \"${workspaceFolder}/tools/validation/semantic/convention/check_convention_compliance.py\"",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "AgentCanon: Dependency Headers",
      "type": "shell",
      "command": "python3 \"${workspaceFolder}/tools/validation/semantic/dependencies/check_dependency_headers.py\" --changed && bash \"${workspaceFolder}/tools/analysis/dependencies/scan_dependency_headers.sh\" --changed --fail-missing && bash \"${workspaceFolder}/tools/validation/semantic/dependencies/check_dependency_header_format.sh\" --changed --require-header",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "C++: Select Compile Database",
      "type": "shell",
      "command": "python3 \"${workspaceFolder}/static_analysis/cpp/static_analysis.py\" select-db --workspace-root \"${workspaceFolder}\" --build-dir \"${input:cppBuildDirectory}\"",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "C++: clangd Check",
      "type": "shell",
      "command": "python3 \"${workspaceFolder}/static_analysis/cpp/static_analysis.py\" clangd-check --workspace-root \"${workspaceFolder}\" --build-dir \"${input:cppBuildDirectory}\" --source \"${file}\"",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "C++: clang-tidy",
      "type": "shell",
      "command": "python3 \"${workspaceFolder}/static_analysis/cpp/static_analysis.py\" clang-tidy --workspace-root \"${workspaceFolder}\" --build-dir \"${input:cppBuildDirectory}\" --source \"${file}\"",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
