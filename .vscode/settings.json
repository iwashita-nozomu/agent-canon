{
  "_dependency_manifest": [
    "@dependency-start",
    "contract reference",
    "responsibility Configures shared VS Code workspace defaults for AgentCanon and template roots.",
    "upstream design ../documents/runtime/SHARED_RUNTIME_SURFACES.md shared runtime surface policy",
    "upstream design ../documents/contracts/github-first-module-and-devcontainer-policy.md VS Code and devcontainer boundary policy",
    "upstream design ../responsibility-scope.toml runtime-entrypoints ownership scope",
    "@dependency-end"
  ],
  "files.associations": {
    "*.cu": "cuda-cpp",
    "*.cuh": "cuda-cpp",
    "*.h": "cpp",
    "*.hpp": "cpp"
  },
  "files.exclude": {
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/__pycache__": true,
    "build": true,
    "logs": true
  },
  "search.exclude": {
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/__pycache__": true,
    "build": true,
    "logs": true
  },
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}/build/cpp/dev"
  ],
  "clangd.path": "clangd",
  "clang-format.executable": "clang-format",
  "[c]": {
    "editor.defaultFormatter": "xaver.clang-format"
  },
  "[cpp]": {
    "editor.defaultFormatter": "xaver.clang-format"
  },
  "[cuda-cpp]": {
    "editor.defaultFormatter": "xaver.clang-format"
  },
  "C_Cpp.intelliSenseEngine": "disabled",
  "C_Cpp.errorSquiggles": "disabled",
  "explorer.excludeGitIgnore": false,
  "python.analysis.extraPaths": [
    "./python",
    "./src",
    "./tools",
    "./tools/agent-canon",
    "./tools/agent-canon/agent_tools"
  ],
  "python-envs.defaultEnvManager": "ms-python.python:system",
  "python-envs.pythonProjects": [],
  "python.envFile": "${workspaceFolder}/.env",
  "jupyter.notebookFileRoot": "${workspaceFolder}"
}
