{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/hook_dispatcher.py UserPromptSubmit",
            "timeout": 40,
            "statusMessage": "Running prompt safety contract"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|python|python3",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/hook_dispatcher.py PreToolUse",
            "timeout": 35,
            "statusMessage": "Running destructive Git safety contract"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|python|python3|Task|spawn_agent|send_input|wait_agent|close_agent|resume_agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/hook_dispatcher.py PostToolUse",
            "timeout": 600,
            "statusMessage": "Running execution-resource projection contract"
          }
        ]
      }
    ]
  }
}
