{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/bootstrap.sh\" --control-parent-root \"${AGENT_CANON_CONTROL_PARENT_ROOT:-$HOME}\" codex hook UserPromptSubmit",
            "timeout": 40,
            "statusMessage": "Running prompt safety contract"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|python|python3",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/bootstrap.sh\" --control-parent-root \"${AGENT_CANON_CONTROL_PARENT_ROOT:-$HOME}\" codex hook PreToolUse",
            "timeout": 35,
            "statusMessage": "Running destructive Git safety contract"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|python|python3|Task|spawn_agent|send_input|wait_agent|close_agent|resume_agent|send_message|followup_task|list_agents|interrupt_agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/bootstrap.sh\" --control-parent-root \"${AGENT_CANON_CONTROL_PARENT_ROOT:-$HOME}\" codex hook PostToolUse",
            "timeout": 600,
            "statusMessage": "Running execution-resource projection contract"
          }
        ]
      }
    ]
  }
}
