{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-canon.local/schemas/agent-canon/tool-catalog.schema.json",
  "title": "AgentCanon structured tool catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "catalog_kind",
    "scope",
    "runtime_schema",
    "status_values",
    "family_values",
    "role_values",
    "audience_values",
    "placement_values",
    "families",
    "default_wiring_docs",
    "entries"
  ],
  "properties": {
    "version": { "const": 1 },
    "catalog_kind": { "const": "agent_canon_tool_catalog" },
    "scope": { "const": "shared_canon" },
    "runtime_schema": { "$ref": "#/$defs/runtimeSchema" },
    "status_values": { "$ref": "#/$defs/nonEmptyStringList" },
    "family_values": { "$ref": "#/$defs/nonEmptyStringList" },
    "role_values": { "$ref": "#/$defs/nonEmptyStringList" },
    "audience_values": { "$ref": "#/$defs/nonEmptyStringList" },
    "placement_values": { "$ref": "#/$defs/nonEmptyStringList" },
    "families": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9_]+$" },
      "additionalProperties": { "$ref": "#/$defs/family" }
    },
    "default_wiring_docs": {
      "type": "array",
      "items": { "$ref": "#/$defs/path" },
      "uniqueItems": true,
      "minItems": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s]+$"
    },
    "nonEmptyStringList": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" },
      "uniqueItems": true,
      "minItems": 1
    },
    "boolPair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ci", "pr_check"],
      "properties": {
        "ci": { "type": "boolean" },
        "pr_check": { "type": "boolean" }
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "summary", "audience", "placement"],
      "properties": {
        "root": { "$ref": "#/$defs/path" },
        "summary": { "$ref": "#/$defs/nonEmptyString" },
        "audience": { "$ref": "#/$defs/nonEmptyString" },
        "placement": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "rustPublicCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "selector", "path"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "selector": { "$ref": "#/$defs/nonEmptyString" },
        "path": { "$ref": "#/$defs/path" },
        "writes": { "type": "boolean" }
      }
    },
    "runtimeSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "default_parity",
        "runtimes",
        "execution_planes",
        "cwd_policies",
        "env_policies",
        "io_policies",
        "exit_policies",
        "side_effect_policies",
        "output_roots",
        "parity_fixture",
        "rust_public_commands"
      ],
      "properties": {
        "version": { "const": 2 },
        "default_parity": { "enum": ["legacy", "verified"] },
        "runtimes": { "$ref": "#/$defs/nonEmptyStringList" },
        "execution_planes": { "$ref": "#/$defs/nonEmptyStringList" },
        "cwd_policies": { "$ref": "#/$defs/nonEmptyStringList" },
        "env_policies": { "$ref": "#/$defs/nonEmptyStringList" },
        "io_policies": { "$ref": "#/$defs/nonEmptyStringList" },
        "exit_policies": { "$ref": "#/$defs/nonEmptyStringList" },
        "side_effect_policies": { "$ref": "#/$defs/nonEmptyStringList" },
        "output_roots": { "$ref": "#/$defs/nonEmptyStringList" },
        "parity_fixture": { "$ref": "#/$defs/path" },
        "rust_public_commands": {
          "type": "array",
          "items": { "$ref": "#/$defs/rustPublicCommand" },
          "uniqueItems": true
        }
      }
    },
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime",
        "argv",
        "execution_plane",
        "cwd",
        "env",
        "stdin",
        "stdout",
        "stderr",
        "exit",
        "signal",
        "side_effect",
        "output_root",
        "written_paths",
        "parity"
      ],
      "properties": {
        "runtime": { "$ref": "#/$defs/nonEmptyString" },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "execution_plane": { "$ref": "#/$defs/nonEmptyString" },
        "cwd": { "$ref": "#/$defs/nonEmptyString" },
        "env": { "$ref": "#/$defs/nonEmptyString" },
        "stdin": { "$ref": "#/$defs/nonEmptyString" },
        "stdout": { "$ref": "#/$defs/nonEmptyString" },
        "stderr": { "$ref": "#/$defs/nonEmptyString" },
        "exit": { "$ref": "#/$defs/nonEmptyString" },
        "signal": { "$ref": "#/$defs/nonEmptyString" },
        "side_effect": { "$ref": "#/$defs/nonEmptyString" },
        "output_root": { "$ref": "#/$defs/nonEmptyString" },
        "written_paths": {
          "type": "array",
          "items": { "$ref": "#/$defs/path" },
          "uniqueItems": true
        },
        "parity": { "enum": ["legacy", "verified"] },
        "parity_fixture": { "$ref": "#/$defs/path" },
        "arguments": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/argument" }
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "summary",
        "path",
        "family",
        "role",
        "status",
        "command",
        "writes",
        "default_wiring",
        "docs",
        "tests"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "summary": { "$ref": "#/$defs/nonEmptyString" },
        "path": { "$ref": "#/$defs/path" },
        "family": { "$ref": "#/$defs/nonEmptyString" },
        "role": { "$ref": "#/$defs/nonEmptyString" },
        "status": { "$ref": "#/$defs/nonEmptyString" },
        "audience": { "$ref": "#/$defs/nonEmptyString" },
        "placement": { "$ref": "#/$defs/nonEmptyString" },
        "command": { "$ref": "#/$defs/nonEmptyString" },
        "writes": { "type": "boolean" },
        "default_wiring": { "$ref": "#/$defs/boolPair" },
        "docs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/path" },
          "uniqueItems": true
        },
        "tests": {
          "type": "array",
          "items": { "$ref": "#/$defs/path" },
          "uniqueItems": true
        },
        "test_exempt_reason": { "$ref": "#/$defs/nonEmptyString" },
        "dispatch": { "$ref": "#/$defs/dispatch" }
      }
    },
    "argument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["string", "literal", "path", "path-list", "enum", "integer", "boolean", "oid", "issue-number"] },
        "flag": { "$ref": "#/$defs/nonEmptyString" },
        "repeat": { "type": "boolean" },
        "required": { "type": "boolean" },
        "choices": { "$ref": "#/$defs/nonEmptyStringList" }
      }
    }
  }
}
