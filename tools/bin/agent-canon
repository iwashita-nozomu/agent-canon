#!/usr/bin/env bash
# @dependency-start
# contract tool
# responsibility Provides the stable AgentCanon CLI through the bootstrap-owned shared tool container.
# upstream design ../../documents/design/agent-canon-bootstrap-tool-runtime.md typed bootstrap request boundary
# downstream implementation ../../tools/agent_tools/tool_dispatch.py request builder and catalog route
# downstream implementation ../../bootstrap.sh host lifecycle entrypoint
# @dependency-end

set -euo pipefail

script_path="${BASH_SOURCE[0]}"
if command -v readlink >/dev/null 2>&1; then
  script_path="$(readlink -f "$script_path")"
fi
canon_root="$(cd "$(dirname "$script_path")/../.." && pwd -P)"
if [ -n "${AGENT_CANON_SOURCE_ROOT:-}" ]; then
  canon_root="$(cd "${AGENT_CANON_SOURCE_ROOT}" && pwd -P)"
fi

runtime_root="${AGENT_CANON_RUNTIME_ROOT:-}"
control_root="${AGENT_CANON_CONTROL_PARENT_ROOT:-}"
if [ -z "$runtime_root" ] || [ -z "$control_root" ]; then
  echo "agent-canon requires AGENT_CANON_CONTROL_PARENT_ROOT and AGENT_CANON_RUNTIME_ROOT" >&2
  exit 2
fi
if [ ! -d "$runtime_root" ] || [ ! -d "$control_root" ]; then
  echo "agent-canon control/runtime roots must already exist" >&2
  exit 2
fi

# The wrapper is a control-plane adapter only. It never runs cargo, invokes a
# Python tool, creates a cache directory, or selects a source-tree fallback.
# The dispatcher submits a typed request to bootstrap, which owns container
# selection, mounts, resource limits, and child process execution.
dispatcher="${canon_root}/tools/agent_tools/tool_dispatch.py"
if [ ! -f "$dispatcher" ]; then
  echo "agent-canon dispatcher is unavailable" >&2
  exit 2
fi

if [ "${1:-}" = "tool" ] && [ "${2:-}" = "run" ]; then
  shift 2
  exec env \
    AGENT_CANON_CONTROL_PARENT_ROOT="$control_root" \
    AGENT_CANON_RUNTIME_ROOT="$runtime_root" \
    AGENT_CANON_SOURCE_ROOT="$canon_root" \
    PYTHONDONTWRITEBYTECODE=1 \
    python3 "$dispatcher" run --root "$canon_root" "$@"
fi

exec env \
  AGENT_CANON_CONTROL_PARENT_ROOT="$control_root" \
  AGENT_CANON_RUNTIME_ROOT="$runtime_root" \
  AGENT_CANON_SOURCE_ROOT="$canon_root" \
  PYTHONDONTWRITEBYTECODE=1 \
  python3 "$dispatcher" rust-cli --root "$canon_root" -- "$@"
