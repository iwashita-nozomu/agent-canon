#!/usr/bin/env bash
# @dependency-start
# contract tool
# responsibility Provides the stable AgentCanon CLI through its native executable.
# upstream design ../../documents/design/agent-canon-bootstrap-tool-runtime.md native CLI distribution
# downstream implementation ../../tools/runtime/dispatch/agent-canon/src/main.rs native CLI entrypoint
# downstream implementation ../../tools/runtime/dispatch/tool_dispatch.py transitional generic catalog route
# @dependency-end

set -euo pipefail

script_path="${BASH_SOURCE[0]}"
while [ -L "$script_path" ]; do
  script_dir="$(cd -P "$(dirname "$script_path")" && pwd)"
  link_target="$(readlink "$script_path")"
  if [[ "$link_target" = /* ]]; then
    script_path="$link_target"
  else
    script_path="$script_dir/$link_target"
  fi
done
script_dir="$(cd -P "$(dirname "$script_path")" && pwd)"
script_path="$script_dir/$(basename "$script_path")"
wrapper_path="$script_path"

if [ -n "${AGENT_CANON_SOURCE_ROOT:-}" ]; then
  canon_root="$(cd "${AGENT_CANON_SOURCE_ROOT}" && pwd -P)"
else
  canon_root="$(cd "$script_dir/../.." && pwd -P)"
fi

# Transitional only: generic catalog tools still use the Python dispatcher.
if [ "${1:-}" = "tool" ] && [ "${2:-}" = "run" ]; then
  runtime_root="${AGENT_CANON_RUNTIME_ROOT:-${canon_root}/.runtime}"
  control_root="${AGENT_CANON_CONTROL_PARENT_ROOT:-}"
  if [ -z "$control_root" ]; then
    echo "agent-canon tool run requires AGENT_CANON_CONTROL_PARENT_ROOT" >&2
    exit 2
  fi
  if [ ! -d "$runtime_root" ] || [ ! -d "$control_root" ]; then
    echo "agent-canon control/runtime roots must already exist" >&2
    exit 2
  fi
  dispatcher="${canon_root}/tools/runtime/dispatch/tool_dispatch.py"
  if [ ! -f "$dispatcher" ]; then
    echo "agent-canon dispatcher is unavailable" >&2
    exit 2
  fi
  shift 2
  exec env \
    AGENT_CANON_CONTROL_PARENT_ROOT="$control_root" \
    AGENT_CANON_RUNTIME_ROOT="$runtime_root" \
    AGENT_CANON_SOURCE_ROOT="$canon_root" \
    PYTHONDONTWRITEBYTECODE=1 \
    python3 "$dispatcher" run --root "$canon_root" "$@"
fi

native_candidates=()
if [ -n "${AGENT_CANON_NATIVE_BIN:-}" ]; then
  native_candidates+=("$AGENT_CANON_NATIVE_BIN")
else
  native_candidates+=(
    "$canon_root/tools/runtime/dispatch/agent-canon/target/release/agent-canon"
    "$canon_root/tools/runtime/dispatch/agent-canon/target/debug/agent-canon"
  )
fi

for native_bin in "${native_candidates[@]}"; do
  if [ ! -x "$native_bin" ] || [ -d "$native_bin" ]; then
    continue
  fi
  if [ "$native_bin" -ef "$wrapper_path" ]; then
    echo "agent-canon native executable resolves to its source wrapper" >&2
    exit 2
  fi
  exec env \
    AGENT_CANON_SOURCE_ROOT="$canon_root" \
    PYTHONDONTWRITEBYTECODE=1 \
    "$native_bin" "$@"
done

echo "agent-canon native executable is unavailable; build the CLI or set AGENT_CANON_NATIVE_BIN" >&2
exit 127
